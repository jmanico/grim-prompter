        "id": "TR-001",
        "threat_refs": [
          "T-001"
        ],
        "outcome": "Authorise every invoice ID at export creation and again in the worker, using the requesting principal's identity rather than the service role.",
        "status": "proposed",
        "alternatives": [
          "Run the worker with a per-request scoped token",
          "Restrict exports to server-side queries owned by the caller"
        ],
        "tradeoffs": [
          "Extra database checks per exported row",
          "Worker must carry the caller's identity"
        ],
